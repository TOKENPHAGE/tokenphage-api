# application-dev.yml 템플릿. 이 파일을 application-dev.yml 로 복사한 뒤
# api-token 등 실제 로컬 값을 채워 사용한다. 실제 dev 파일은 .gitignore 로 제외된다.
#
#   cp application-dev.yml.example application-dev.yml
#
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/tokenphage
    username: your-name
    password: your-password
  data:
    redis:
      url: redis://localhost:0000

badge:
  api-base-url: http://localhost:8080
  jwt-secret: dev-secret-change-in-production-x

auth:
  gist:
    # scope 없는 GitHub PAT 를 발급해 채운다 (미인증 캐시/레이트리밋 회피용).
    api-token: ghp_REPLACE_WITH_YOUR_LOCAL_TOKEN
