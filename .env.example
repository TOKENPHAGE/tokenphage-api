# =============================================================
# tokenphage-api 운영(.env) 템플릿
#   cp .env.example .env  후 아래 값들을 채워 사용한다.
#   docker compose 가 이 파일을 읽어 컨테이너에 주입한다.
#
# ⚠️  정합성 규칙 — 아래 짝은 반드시 같은 값이어야 한다:
#     POSTGRES_PASSWORD == DB_PASS
#     POSTGRES_USER     == DB_USER
#     POSTGRES_DB       == DATABASE_URL 안의 DB명
#   어긋나면 앱이 DB 인증/접속에 실패한다.
# =============================================================

# ── 프로파일 모드 ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── PostgreSQL ────────────────────────────────────────────
# POSTGRES_* 는 DB 컨테이너 초기화용, DB_* 는 앱 접속용 (값은 짝끼리 동일).
# DATABASE_URL 의 호스트는 compose 서비스명(postgres), DB명은 POSTGRES_DB 와 일치.
POSTGRES_DB=tokenphage
POSTGRES_USER=tokenphage
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://postgres:5432/tokenphage

# ── Redis ─────────────────────────────────────────────────
# REDIS_PASSWORD 는 redis 컨테이너(requirepass)와 앱이 공용으로 사용.
# REDIS_HOST 는 compose 서비스명(redis).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ── 애플리케이션 ──────────────────────────────────────────
API_BASE_URL=https://api.tokenphage.com
DB_USER=tokenphage
DB_PASS=change-me

# JWT_SECRET: HMAC-SHA 서명 키. 최소 32바이트(256비트) 필수 —
#   미달 시 기동 시점에 WeakKeyException 으로 실패한다.
#   아래 명령으로 안전한 값을 생성해 채울 것:
#     openssl rand -base64 48
JWT_SECRET=<generate: openssl rand -base64 48>

# GitHub Gist 인증용 Personal Access Token (gist read 권한)
GIST_API_TOKEN=ghp_REPLACE_WITH_YOUR_TOKEN

# ── 선택 (기본값 있음, 필요 시 주석 해제) ──────────────────
# PORT=8080
# BADGE_TIMEZONE=Asia/Seoul
# AUTH_CHALLENGE_TTL_MINUTES=10
# GIST_API_BASE_URL=https://api.github.com
